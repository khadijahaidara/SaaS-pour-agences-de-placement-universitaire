# Copier en .env puis adapter.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=remplacer-par-une-longue-chaine-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://placement.neuralis-mali.com

# Sans DATABASE_URL : SQLite (db.sqlite3). Production : PostgreSQL.
# DATABASE_URL=postgres://placement:placement@localhost:5432/placement

# Pièces des étudiants (dossier privé, jamais servi directement par le serveur web)
# MEDIA_ROOT=/var/lib/placement/media
MAX_UPLOAD_SIZE_MB=10

# Courriel (console en développement)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Suivi dossiers <no-reply@neuralis-mali.com>

SITE_NAME=NEURALIS Mobility
STALE_DOSSIER_DAYS=14
TIME_ZONE=Africa/Bamako

# Adresse web des agences : <sous-domaine>.BASE_DOMAIN (en dev : localhost → agence.localhost:8000)
# BASE_DOMAIN=neuralis-mobility.com
# Quota de l'API par agence
API_RATE_LIMIT=600/hour

# File de tâches et cache (recommandé en production) : sans REDIS_URL, les tâches
# (courriels, webhooks) s'exécutent immédiatement et les tâches planifiées passent
# par « manage.py run_scheduled_tasks » (cron / Planificateur de tâches).
# REDIS_URL=redis://localhost:6379/0

# Sécurité des connexions
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
AUDIT_RETENTION_DAYS=365

# Webhooks (en production : https et adresses publiques uniquement)
WEBHOOK_TIMEOUT=10
# WEBHOOK_ALLOW_PRIVATE=0

# Factures d'abonnement NEURALIS
BILLING_ISSUER_NAME=NEURALIS SARL
BILLING_ISSUER_ADDRESS=Bamako, Mali
BILLING_ISSUER_EMAIL=contact@neuralis-mali.com
# BILLING_ISSUER_LEGAL=RCCM … · NIF …
BILLING_PAYMENT_INFO=Orange Money, Moov Money ou virement bancaire — référence : numéro de facture.
